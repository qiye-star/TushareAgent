# demo-mcp 独立配置模板 —— 复制为 .env 并填真实值（.env 不提交）
# LLM（DeepSeek / OpenAI 兼容端点）
DS_API_KEY=
DS_BASE_URL=https://api.deepseek.com
DS_MODEL=deepseek-chat
DS_STREAMING=true
DS_MAX_TOKENS=8192
DEMO_MAX_ITERATIONS=10

# 会话历史库（SQLAlchemy 异步；默认 SQLite demo.db；也支持 mysql/asyncmy、postgres/asyncpg）
DEMO_DATABASE_URL=sqlite+aiosqlite:///./demo.db

# MCP 服务器启动（MCP_PYTHON 留空=当前解释器；MCP_SERVER_PATH 留空=内置 demo-mcp/mcp_server/server.py）
MCP_PYTHON=
MCP_SERVER_PATH=
DEMO_MCP_TIMEOUT=30
DEMO_MCP_RETRIES=2

# 透传给 MCP 服务器子进程的代理参数（名字与 mcp_server 的 os.environ 一致）
TUSHARE_PROXY_URL=http://127.0.0.1:8000
TUSHARE_API_KEY=
TUSHARE_PROXY_TIMEOUT=20
