# demo-mcp 独立配置模板 —— 复制为 .env 并填真实值（.env 不提交）
# LLM（DeepSeek / OpenAI 兼容端点）
DS_API_KEY=
DS_BASE_URL=https://api.deepseek.com
DS_MODEL=deepseek-chat
DS_STREAMING=true
DS_MAX_TOKENS=8192
DEMO_MAX_ITERATIONS=10

# 会话历史库（SQLAlchemy 异步；默认 SQLite demo.db；也支持 mysql/asyncmy、postgres/asyncpg）
DEMO_DATABASE_URL=sqlite+aiosqlite:///./demo.db

# 取数：本服务**不直连任何数据源**，只作为 MCP 客户端连独立部署的 MCP 网关（见 mcp_gateway/）。
# 上游源（Tushare 官方 MCP / 万得 Wind / 未来更多）的地址与 key 一律配在 mcp_gateway/.env，
# 并在网关里按源开关（前端「设置」页 → 数据源明细）。这里只需要知道网关在哪。
#   本地：http://127.0.0.1:8766/mcp（默认值，起网关：.\scripts\dev_up.ps1）
#   容器：http://mcp-gateway:8766/mcp（docker-compose.yml 已在 demo service 里设好）
MCP_GATEWAY_URL=http://127.0.0.1:8766/mcp
# 网关管理 REST 的 base url（前端按源开关页调用）；留空则从 MCP_GATEWAY_URL 自动推导（同 host:port）
MCP_GATEWAY_ADMIN_URL=
# 下面几个描述的是「本服务 → 网关」这一条连接
DEMO_MCP_TIMEOUT=30
DEMO_MCP_RETRIES=2
# 保活（防断联）：周期 send_ping 探测，断线自动重建；0=关闭
DEMO_MCP_KEEPALIVE=45
# 热启动：web 启动即连网关（不等首个 /chat）；网关没起来会退避重试，不影响本服务启动。false=冷连
TOOL_POOL_HOT_START=true

# 另有一个「总闸」：是否使用取数工具，持久化在 data/settings/mcp_toggle.json，经
# GET/POST /api/settings/mcp 或前端「设置」页切换（无需重启进程、不经本文件）；关掉 → 连网关都不连，
# 对话退化为纯 LLM 聊天。按源的细粒度开关在网关侧，见 mcp_gateway/。

# 动态工具目录：per-query 只把相关子集喂给 LLM（list_apis/get_api_info/query/stock_basic 恒在兜底）。
# TOOL_PROBE_ENABLED=true 时才启动时逐个接口探测可用性并写缓存（默认关，避免真实调用烧积分/依赖未验证的官方 MCP 契约）。
# 有缓存 data/tool_catalog.json 时 agent 自动剔除 blocked/down 接口。
TOOL_MAX_REVEALED=12
TOOL_META_ALWAYS=true
TOOL_PROBE_ENABLED=false
TOOL_PROBE_CACHE_PATH=
TOOL_PROBE_CONCURRENCY=4

# 上游数据源（TUSHARE_MCP_URL / WIND_API_KEY / WIND_ENABLED）**已迁往 mcp_gateway/.env**——
# 网关是唯一持有上游连接的进程，本服务读不到也不需要这些值（在这里配了不会生效）。
# 万得的 key 获取：https://aifinmarket.wind.com.cn/#/user/overview

# 快报（quickreport）：独立的确定性六段式日报（不经 LLM）。QUICKREPORT_AUTO=false 关闭每日定时任务与启动补跑。
# QUICKREPORT_DIR 覆盖数据目录（watchlist.json/latest.json/history/ 的所在目录；默认 data/quickreport）。
QUICKREPORT_ENABLED=true
QUICKREPORT_AUTO=true
QUICKREPORT_DIR=
QUICKREPORT_STAGE_TIMEOUT=60
QUICKREPORT_CONCURRENCY=4

# RAG 财报知识库（离线优先：默认纯 Python，无需任何新依赖；RAG_USE_REAL=true 才需 uv sync --extra rag-full）
# 向量模型默认真实 BGE-M3（需装 rag-full/sentence-transformers）；离线测试可设 RAG_EMBEDDING_MODEL=hashing
RAG_USE_REAL=false
# RAG 持久化目录：Milvus‑Lite 向量库 + SQLite 关系库（rag_rel.db）都放这里；`uv sync --extra rag-full`
RAG_VECTOR_STORE_PATH=
# 默认真实向量模型 BAAI/bge-m3：走 OpenAI 兼容 /embeddings 服务（本地不加载模型）
RAG_EMBEDDING_MODEL=BAAI/bge-m3
# 嵌入 API：base_url + api_key（SiliconFlow https://api.siliconflow.cn/v1）；提供二者且 RAG_USE_REAL=true 才走 API，否则回退 hashing
RAG_EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_DIM=256
# 多模态图块描述：默认为 deepseek-v4-flash-vision-exp，需 DS_API_KEY；无 key 则回退 Noop 跳过图块
RAG_CAPTIONER=deepseek-v4-flash-vision-exp
# 重排：SiliconFlow 服务端 /v1/rerank（bge-reranker-v2-m3），复用上面的 base_url/api_key；无 key 回退 Noop
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_TOP_K=5
RAG_CANDIDATE_K=50
RAG_TOP_K_SECTIONS=5
RAG_SCORE_THRESHOLD=0.3
RAG_RERANK_THRESHOLD=0.2
RAG_RERANK_CANDIDATES=30
RAG_FIN_DENSE_CHUNK=400
RAG_FIN_DENSE_OVERLAP=80
RAG_SECTION_MAX_CHARS=8000
RAG_TABLE_ROWS_PER_CHUNK=8
RAG_HYBRID_DENSE_WEIGHT=0.6
RAG_STRICT_SCOPE=true
RAG_HYDE=false
RAG_STRATEGY=auto
RAG_TABLE_ENGINE=pymupdf
RAG_RRF_K=60
RAG_BM25_K1=1.5
RAG_BM25_B=0.75

# 检索复用：非空 → agent 经 HTTP 检索（运行中的 web /api/rag/retrieve），本进程不再打开 Milvus（其单进程独占锁）。
# 用于「让 CLI/脚本/2nd worker 也能拿到 RAG」而不与持有索引的 web 进程抢锁。
# 例如 RAG_HTTP_URL=http://127.0.0.1:8010
RAG_HTTP_URL=
RAG_HTTP_TIMEOUT=20
RAG_HTTP_TOKEN=

# 内置 mcp_server/（本地代理→每接口工具）默认停用，仅作后备；若要单独跑它（本地进程或
# `docker compose --profile mcp-server up -d`，见 docker-compose.yml）才需要以下环境变量：
#   MCP_SERVER_HOST / MCP_SERVER_PORT，以及它后端的 Tushare 数据代理（不在本仓库内，需另行部署/可达）：
# TUSHARE_PROXY_URL=http://127.0.0.1:8000
# TUSHARE_API_KEY=
# TUSHARE_PROXY_TIMEOUT=20
# 容器化部署它时 MCP_SERVER_HOST 必须是 0.0.0.0（默认 127.0.0.1 在容器里外部连不进来，
# docker-compose.yml 的 mcp-server service 已覆盖）；若要让 demo 主服务改用它而非官方 MCP，
# 把上面的 TUSHARE_MCP_URL 改成 compose 网络内地址 http://mcp-server:8765/mcp。
