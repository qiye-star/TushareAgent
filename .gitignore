# demo-mcp 本地忽略（根 .gitignore 已按任一层级覆盖 .env/.venv/*.db/__pycache__/，这里补构建产物）
*.egg-info/
__pycache__/
.pytest_cache/
.ruff_cache/
*.db
# RAG 持久化索引目录（Milvus-Lite + SQLite 关系库，运行时产物不入库）
data/vectorstore/

# 快报运行时产物（latest.json 每次生成覆盖；history/ 按日存档；watchlist.json 是配置、随仓库提交）
data/quickreport/latest.json
data/quickreport/last_error.json
data/quickreport/history/
# MCP 全局开关运行态（demomcp 侧）+ 网关按源开关/运行态（mcp_gateway 侧）——都是运行时状态，不是配置模板
data/settings/mcp_toggle.json
mcp_gateway/data/
.env
.venv/
*.log

# web 构建产物 / 依赖（前端已迁到 node_modules；vendored 改为本地不提交、由 CDN 兜底）
scripts/web/node_modules/
scripts/web/dist/
scripts/web/.vite/
scripts/web/vendor/

# 对话文本日志（logs/chat.log 等，UTF-8 + 轮转）
logs/
