# MCP 网关独立配置模板 —— **必需**：复制为 mcp_gateway/.env 并填真实值（.env 不提交）。
#   copy mcp_gateway\.env.example mcp_gateway\.env
# 网关是整个系统里**唯一**持有上游数据源凭证的进程；从项目根 .env 把这两行搬过来即可：
#   TUSHARE_MCP_URL=...（带 ?token=）
#   WIND_API_KEY=...   （不用万得就留空并设 WIND_ENABLED=false）
# 根 .env 里那两项此后不再被 demomcp 读取（它只知道 MCP_GATEWAY_URL）。
# 一个源配不配，只看它自己那几行：留空即不注册，不会留下一个永远连不上的开关项。
# 各源之间**没有自动降级**——工具名互不重叠（wind_* / ifind_* / Tushare 原生名），
# 「某源没权限就换另一源」是 agent 选工具时的语义行为，不是网关的路由行为。
# 没建这个文件也不会崩：网关照常启动，但会在启动日志与 /admin/health 的 config_problems 里
# 明确告诉你缺什么，前端「设置 → 数据源明细」也会显示出来。

# 监听地址（容器里必须是 0.0.0.0；本地跑可以留默认）
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8766
# 按源开关持久化 + 其它运行态数据存放目录（留空 = mcp_gateway/data/）
GATEWAY_DATA_DIR=

# 上游源一：Tushare 官方 MCP（token 放 URL query）
TUSHARE_MCP_URL=https://api.tushare.pro/mcp/?token=YOUR_TUSHARE_TOKEN

# 上游源二：万得（Wind）。留空 WIND_API_KEY 或 WIND_ENABLED=false 时不注册该源
# （sources.py 的 build_sources() 不会注册 wind，/admin/sources 里也不会出现它）。
WIND_API_KEY=
WIND_ENABLED=true

# 上游源三：同花顺 iFind（远程多域 MCP，7 个域）。密钥申请：https://mcp.51ifind.com/ → 个人中心
# 注意鉴权头是**裸 token**（不带 Bearer 前缀，与万得不同，抄串了会全域 401）。
IFIND_AUTH_TOKEN=
IFIND_ENABLED=true
# iFind 按套餐硬限并发：免费版 2 / 个人版 5 / 企业版 10。超限远端直接拒绝，别乱调大。
IFIND_CONCURRENCY=2

# 上游源四、五：免费源，各自跑在**独立进程**里（见 external_sources/README.md），
# 网关只当普通 MCP 客户端连它们的 URL——留空即不注册。网关不负责拉起这两个进程，
# 它们没起来时只是该源连不上，网关与 demomcp 照常工作。
#   python external_sources/akshare_server.py     --port 8000
#   python external_sources/china_news_server.py  --port 8001
AKSHARE_MCP_URL=
CHINA_NEWS_MCP_URL=

# 每个上游源连接的超时/重试/保活（与 demomcp 的 DEMO_MCP_* 语义一致，这里去掉 DEMO_ 前缀）
MCP_TIMEOUT=30
MCP_RETRIES=2
MCP_KEEPALIVE=45
